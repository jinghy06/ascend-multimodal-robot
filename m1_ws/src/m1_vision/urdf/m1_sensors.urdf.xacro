<?xml version="1.0"?>
<!--
  M1 传感器 TF 片段：并入整机 URDF（map → odom → base_link → {camera_link, laser_frame}）。
  W2 标定周实测以下外参并替换数值：
    camera_xyz / camera_rpy：相机相对 base_link 的安装位置与俯仰角
    laser_xyz              ：雷达相对 base_link 的安装位置
  注意：camera_link 采用光学坐标系约定（z 前、x 右、y 下），fusion_ranging_node
  按此约定做视线反投影；若整机 URDF 用机身坐标系（x 前），请在此处加固定旋转。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="m1_sensors">

  <xacro:property name="laser_xyz" value="0.10 0.0 0.20"/>
  <xacro:property name="camera_xyz" value="0.12 0.0 0.35"/>
  <xacro:property name="camera_rpy" value="0 0.1745 0"/>  <!-- 俯仰约 10°，W2 实测 -->

  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${laser_xyz}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.08 0.02"/></geometry>
    </visual>
  </link>
  <!-- 安装俯仰用中间帧实现，便于 W2 只改一个数 -->
  <link name="camera_mount"/>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount"/>
    <origin xyz="${camera_xyz}" rpy="0 ${camera_rpy} 0"/>
  </joint>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0" rpy="${-1.5708} 0 ${-1.5708}"/>
  </joint>

</robot>
